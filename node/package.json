{
  "name": "tomo-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tomo Node.js microservice — multi-role (yjs server/worker + Fastify api). Role selected by YHUB_ROLE.",
  "scripts": {
    "build": "tsc",
    "server": "node --import ./dist/tracing.js dist/roles/server.js",
    "worker": "node --import ./dist/tracing.js dist/roles/worker.js",
    "api": "node --import ./dist/tracing.js dist/roles/api.js",
    "dev:api": "tsx watch src/roles/api.ts",
    "gen-keys": "node scripts/gen-keys.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@opentelemetry/auto-instrumentations-node": "^0.49.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@y/redis": "^0.1.6",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "ioredis": "^5.3.2",
    "jose": "^5.0.0",
    "node-cache": "^5.1.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
