YJS_JAVA_BASE_URL=http://127.0.0.1:8080/api/v1
YJS_SERVICE_SHARED_SECRET=tomo-local-dev-yjs-token-secret-2026
REDIS=redis://127.0.0.1:6379
REDIS_PREFIX=yhub
