# tomo-node environment configuration
PORT=8006
CACHE_TTL_SECONDS=259200
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=15
CORS_ORIGIN=*
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=vi

# server / worker (yhub) roles
