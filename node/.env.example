# tomo-node — role selected by YHUB_ROLE: server | worker | api

# ----- api role (translate HTTP service) -----
PORT=8006
CACHE_TTL_SECONDS=259200       # parsed-translation cache TTL (3 days)
RATE_LIMIT_WINDOW_MS=60000     # per-IP window
RATE_LIMIT_MAX=15              # per-IP max requests / window
CORS_ORIGIN=*
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=vi

# ----- server / worker roles (yjs) — see docs/yhub.md -----
# REDIS=redis://:pass@redis:6379
# REDIS_PREFIX=yhub
# AUTH_PUBLIC_KEY={"kty":"EC",...}        # P-384 JWK (verify)
# AUTH_PERM_CALLBACK=http://base:8080/yjs/auth/perm
# YJS_JAVA_BASE_URL=http://base:8080
# YJS_SERVICE_SHARED_SECRET=...
# REDIS_TASK_DEBOUNCE=5000
# KEYFRAME_INTERVAL=20
# RECONSTRUCT_PORT=1236

# ----- observability (all roles) -----
# OTEL_SERVICE_NAME=tomo-node-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.tomo-infra.svc.cluster.local:4318
