APP_ENV=development
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=*

# Shared Local PostgreSQL Container (Container: postgresql)
DB_DRIVER=postgres
DB_DSN=host=localhost user=postgres password=postgres dbname=tomo port=5432 sslmode=disable TimeZone=Asia/Ho_Chi_Minh

# Dev Security Secrets
JWT_SECRET=tomo-local-dev-jwt-secret-key-2026-safe-for-local
JWT_ACCESS_TTL_MINUTES=120
JWT_REFRESH_TTL_DAYS=14

YJS_SECRET=tomo-local-dev-yjs-token-secret-2026
