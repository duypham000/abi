# ==========================================
# TOMO BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Application Environment: development | production | staging | test
APP_ENV=development

# Server Port
SERVER_PORT=8080

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Settings
# For SQLite (Local):
DB_DRIVER=sqlite
DB_DSN=tomo_dev.db

# For PostgreSQL (Production):
# DB_DRIVER=postgres
# DB_DSN=host=localhost user=tomo_user password=tomo_secure_pass dbname=tomo_db port=5432 sslmode=disable TimeZone=UTC

# JWT Security Settings
JWT_SECRET=replace-with-a-very-strong-production-jwt-secret-key-32-chars
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# Yjs Security Settings
YJS_SECRET=replace-with-a-very-strong-yjs-token-secret-key
