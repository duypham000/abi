# ==============================================================================
# Environment Configuration: PRODUCTION (Kết nối PostgreSQL & Redis cùng Server)
# ==============================================================================

# PostgreSQL chạy trên cùng Server (Native Service hoặc Container độc lập)
# Nhờ extra_hosts trong docker-compose.yml, dùng host.docker.internal để trỏ về host server
DB_DRIVER=postgres
DB_DSN=host=host.docker.internal user=admin password=admin dbname=tomo_prod_db port=5432 sslmode=disable TimeZone=UTC

# Redis chạy trên cùng Server
# Nếu Redis có đặt mật khẩu: redis://:mật_khẩu@host.docker.internal:6379
REDIS=redis://host.docker.internal:6379
REDIS_PREFIX=yhub

# Security Secrets (Production - hãy đổi thành chuỗi bảo mật ngẫu nhiên của bạn)
JWT_SECRET=prod-jwt-secret-key-must-be-very-secure-32chars
YJS_SECRET=prod-yjs-token-secret-2026-very-secure
AUTH_PUBLIC_KEY={"kty":"EC","x":"aUfgT3waVAQ-qprg-mzNcGIjXGc6808bgnIPeGQBAbcLInPgVaYCTFo2OB1yBmv_","y":"5gv7QwZ_D8AGw8Je0Gay8zDZhBux7oDocND2cCN4H9Z77Vdr1G2ANM98x0bO7um5","crv":"P-384","key_ops":["verify"]}

# Application settings
APP_ENV=production
CORS_ALLOWED_ORIGINS=*
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=vi

# Exposed Ports
BACKEND_PORT=8080
NODE_API_PORT=8006
NODE_YJS_PORT=1234
