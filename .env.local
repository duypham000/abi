# ==============================================================================
# Environment Configuration: LOCAL (Kết nối PostgreSQL & Redis Local)
# ==============================================================================

# PostgreSQL Local (trên máy dev của bạn)
# Khi chạy qua Docker, dùng host.docker.internal để trỏ về PostgreSQL trên máy
DB_DRIVER=postgres
DB_DSN=host=host.docker.internal user=tomo_user password=tomo_password dbname=tomo_db port=5432 sslmode=disable TimeZone=UTC

# Redis Local (trên máy dev của bạn)
REDIS=redis://host.docker.internal:6379
REDIS_PREFIX=yhub

# Security Secrets (Local Dev)
JWT_SECRET=tomo-local-dev-jwt-secret-key-32chars
YJS_SECRET=tomo-local-dev-yjs-token-secret-2026
AUTH_PUBLIC_KEY={"kty":"EC","x":"aUfgT3waVAQ-qprg-mzNcGIjXGc6808bgnIPeGQBAbcLInPgVaYCTFo2OB1yBmv_","y":"5gv7QwZ_D8AGw8Je0Gay8zDZhBux7oDocND2cCN4H9Z77Vdr1G2ANM98x0bO7um5","crv":"P-384","key_ops":["verify"]}

# Application settings
APP_ENV=development
CORS_ALLOWED_ORIGINS=*
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=vi

# Exposed Ports
BACKEND_PORT=8080
NODE_API_PORT=8006
NODE_YJS_PORT=1234
