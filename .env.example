# ==============================================================================
# Portainer Stack Environment Variables Configuration (Template)
# ==============================================================================
# Bạn có thể copy nội dung này dán vào mục "Environment variables" trên Portainer Stack.

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Khi PostgreSQL chạy trên cùng máy chủ (host), dùng host.docker.internal:
DB_DRIVER=postgres
DB_DSN=host=host.docker.internal user=tomo_user password=your_password dbname=tomo_prod_db port=5432 sslmode=disable TimeZone=UTC

# ------------------------------------------------------------------------------
# 2. CACHE & PUBSUB (Redis)
# ------------------------------------------------------------------------------
# Khi Redis chạy trên cùng máy chủ (host):
# Không pass: redis://host.docker.internal:6379
# Có pass:    redis://:your_password@host.docker.internal:6379
REDIS=redis://host.docker.internal:6379
REDIS_PREFIX=yhub

# ------------------------------------------------------------------------------
# 3. SECURITY & SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-very-secure-random-32char-key
YJS_SECRET=change-this-to-a-very-secure-random-token-2026
AUTH_PUBLIC_KEY={"kty":"EC","x":"aUfgT3waVAQ-qprg-mzNcGIjXGc6808bgnIPeGQBAbcLInPgVaYCTFo2OB1yBmv_","y":"5gv7QwZ_D8AGw8Je0Gay8zDZhBux7oDocND2cCN4H9Z77Vdr1G2ANM98x0bO7um5","crv":"P-384","key_ops":["verify"]}

# ------------------------------------------------------------------------------
# 4. GENERAL APP SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=production
CORS_ALLOWED_ORIGINS=*
DEFAULT_SOURCE_LANG=en
DEFAULT_TARGET_LANG=vi

# ------------------------------------------------------------------------------
# 5. EXPOSED PORTS
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
NODE_API_PORT=8006
NODE_YJS_PORT=1234
